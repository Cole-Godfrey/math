module

public import Mathlib.RepresentationTheory.Invariants
public import Mathlib.RepresentationTheory.Coinvariants

set_option autoImplicit false
set_option warningAsError true

@[expose] public section

open scoped BigOperators

namespace Math.RepresentationTheory

variable {k G V W U : Type*} [CommRing k] [Group G]
  [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W]
  [AddCommGroup U] [Module k U]

variable (ρ : Representation k G V) (σ : Representation k G W)
  (τ : Representation k G U)

section Finite

variable [Fintype G] [Invertible (Fintype.card G : k)]

/-- averaging is the normalized sum of the group action. -/
theorem averageMap_apply (v : V) :
    ρ.averageMap v = ⅟(Fintype.card G : k) • ∑ g : G, ρ g v := by
  simp [Representation.averageMap, GroupAlgebra.average, map_sum, LinearMap.sum_apply]

/-- averaging is unchanged by applying a group element first. -/
theorem averageMap_action (g : G) (v : V) :
    ρ.averageMap (ρ g v) = ρ.averageMap v := by
  rw [Representation.averageMap, ← Representation.asAlgebraHom_single_one,
    ← Module.End.mul_apply, ← map_mul, GroupAlgebra.mul_average_right]

/-- averaging acts as the identity on coinvariant classes. -/
theorem coinvariants_mk_averageMap (v : V) :
    Representation.Coinvariants.mk ρ (ρ.averageMap v) =
      Representation.Coinvariants.mk ρ v := by
  rw [averageMap_apply]
  simp [map_sum, Representation.Coinvariants.mk_self_apply,
    ← Nat.cast_smul_eq_nsmul k, smul_smul]

/-- the averaging kernel is generated by differences of group translates. -/
theorem ker_averageMap : LinearMap.ker ρ.averageMap = Representation.Coinvariants.ker ρ := by
  apply le_antisymm
  · intro v hv
    apply (Representation.Coinvariants.mk_eq_zero ρ).mp
    rw [← coinvariants_mk_averageMap ρ v, LinearMap.mem_ker.mp hv, map_zero]
  · refine Submodule.span_le.mpr ?_
    rintro _ ⟨⟨g, v⟩, rfl⟩
    change ρ.averageMap (ρ g v - v) = 0
    rw [map_sub, averageMap_action, sub_self]

/-- a vector is invariant exactly when averaging fixes it. -/
theorem mem_invariants_iff_averageMap (v : V) :
    v ∈ ρ.invariants ↔ ρ.averageMap v = v :=
  ρ.isProj_averageMap.mem_iff_map_id

/-- the invariant submodule is the image of averaging. -/
theorem range_averageMap : LinearMap.range ρ.averageMap = ρ.invariants :=
  ρ.isProj_averageMap.range

/-- invariants and translate differences are complementary submodules. -/
theorem isCompl_invariants_coinvariantsKer :
    IsCompl ρ.invariants (Representation.Coinvariants.ker ρ) := by
  rw [← ker_averageMap]
  exact ρ.isProj_averageMap.isCompl

/-- averaging with its codomain restricted to invariant vectors. -/
noncomputable def reynolds : V →ₗ[k] ρ.invariants :=
  ρ.isProj_averageMap.codRestrict

/-- the restricted averaging map retains its underlying vector. -/
theorem reynolds_coe (v : V) : (reynolds ρ v : V) = ρ.averageMap v := rfl

/-- averaging retracts the inclusion of invariant vectors. -/
theorem reynolds_invariant (v : ρ.invariants) : reynolds ρ v = v :=
  ρ.isProj_averageMap.codRestrict_apply_cod v

/-- the restricted averaging map is unchanged on group translates. -/
theorem reynolds_action (g : G) (v : V) : reynolds ρ (ρ g v) = reynolds ρ v := by
  apply Subtype.ext
  exact averageMap_action ρ g v

/-- averaging descends from coinvariants to invariant vectors. -/
noncomputable def coinvariantsToInvariants : ρ.Coinvariants →ₗ[k] ρ.invariants :=
  Representation.Coinvariants.lift ρ (reynolds ρ)
    (fun g => LinearMap.ext fun v => reynolds_action ρ g v)

/-- invariant vectors map to their coinvariant classes. -/
noncomputable def invariantsToCoinvariants : ρ.invariants →ₗ[k] ρ.Coinvariants :=
  (Representation.Coinvariants.mk ρ).comp ρ.invariants.subtype

/-- averaging canonically identifies coinvariants with invariants. -/
noncomputable def coinvariantsInvariantsEquiv : ρ.Coinvariants ≃ₗ[k] ρ.invariants where
  toLinearMap := coinvariantsToInvariants ρ
  invFun := invariantsToCoinvariants ρ
  left_inv x := Representation.Coinvariants.induction_on x fun v =>
    coinvariants_mk_averageMap ρ v
  right_inv v := reynolds_invariant ρ v

/-- the equivalence sends a coinvariant class to its averaged representative. -/
theorem coinvariantsInvariantsEquiv_mk (v : V) :
    coinvariantsInvariantsEquiv ρ (Representation.Coinvariants.mk ρ v) = reynolds ρ v := rfl

/-- the inverse equivalence takes the class of an invariant vector. -/
theorem coinvariantsInvariantsEquiv_symm (v : ρ.invariants) :
    (coinvariantsInvariantsEquiv ρ).symm v = Representation.Coinvariants.mk ρ v := rfl

/-- equivariant linear maps commute with averaging. -/
theorem averageMap_natural (f : Representation.IntertwiningMap ρ σ) (v : V) :
    f (ρ.averageMap v) = σ.averageMap (f v) := by
  simp only [averageMap_apply, map_smul, map_sum, f.isIntertwining]

end Finite

/-- an equivariant map restricts to invariant vectors. -/
noncomputable def mapInvariants (f : Representation.IntertwiningMap ρ σ) :
    ρ.invariants →ₗ[k] σ.invariants :=
  (f.toLinearMap.comp ρ.invariants.subtype).codRestrict σ.invariants fun v g =>
    (Representation.IntertwiningMap.isIntertwining ρ σ f g v).symm.trans
      (congrArg f (v.property g))

/-- the invariant restriction retains the original equivariant map. -/
theorem mapInvariants_coe (f : Representation.IntertwiningMap ρ σ) (v : ρ.invariants) :
    (mapInvariants ρ σ f v : W) = f v := rfl

/-- restriction to invariants preserves injective equivariant maps. -/
theorem mapInvariants_injective (f : Representation.IntertwiningMap ρ σ)
    (hf : Function.Injective f) : Function.Injective (mapInvariants ρ σ f) := by
  intro v w h
  exact Subtype.ext (hf (congrArg Subtype.val h))

section Finite

variable [Fintype G] [Invertible (Fintype.card G : k)]

/-- the coinvariant and invariant identification commutes with equivariant maps. -/
theorem coinvariantsInvariantsEquiv_natural
    (f : Representation.IntertwiningMap ρ σ) (x : ρ.Coinvariants) :
    mapInvariants ρ σ f (coinvariantsInvariantsEquiv ρ x) =
      coinvariantsInvariantsEquiv σ (Representation.Coinvariants.map ρ σ f x) := by
  induction x using Representation.Coinvariants.induction_on with
  | h v =>
    apply Subtype.ext
    exact averageMap_natural ρ σ f v

/-- every invariant target of an equivariant surjection has an invariant preimage. -/
theorem mapInvariants_surjective (f : Representation.IntertwiningMap ρ σ)
    (hf : Function.Surjective f) : Function.Surjective (mapInvariants ρ σ f) := by
  intro w
  obtain ⟨v, hv⟩ := hf w
  refine ⟨reynolds ρ v, Subtype.ext ?_⟩
  change f (ρ.averageMap v) = (w : W)
  rw [averageMap_natural, hv]
  exact σ.averageMap_id w w.property

/-- taking invariants preserves exactness of equivariant linear maps. -/
theorem mapInvariants_exact
    (f : Representation.IntertwiningMap ρ σ) (g : Representation.IntertwiningMap σ τ)
    (hex : LinearMap.range f.toLinearMap = LinearMap.ker g.toLinearMap) :
    LinearMap.range (mapInvariants ρ σ f) = LinearMap.ker (mapInvariants σ τ g) := by
  ext w
  constructor
  · rintro ⟨v, rfl⟩
    change mapInvariants σ τ g (mapInvariants ρ σ f v) = 0
    apply Subtype.ext
    change g (f (v : V)) = 0
    have hv : f.toLinearMap (v : V) ∈ LinearMap.ker g.toLinearMap := by
      rw [← hex]
      exact LinearMap.mem_range_self f.toLinearMap v
    exact hv
  · intro hw
    have hw0 : g.toLinearMap (w : W) = 0 :=
      congrArg Subtype.val (show mapInvariants σ τ g w = 0 from hw)
    have hmem : (w : W) ∈ LinearMap.range f.toLinearMap := by
      rw [hex]
      exact hw0
    obtain ⟨v, hv⟩ := hmem
    refine ⟨reynolds ρ v, Subtype.ext ?_⟩
    change f (ρ.averageMap v) = (w : W)
    rw [averageMap_natural]
    change σ.averageMap (f.toLinearMap v) = (w : W)
    rw [hv]
    exact σ.averageMap_id w w.property

/-- invariant vectors and translate differences reconstruct the representation. -/
noncomputable def invariantDifferenceEquiv :
    (ρ.invariants × Representation.Coinvariants.ker ρ) ≃ₗ[k] V :=
  ρ.invariants.prodEquivOfIsCompl _ (isCompl_invariants_coinvariantsKer ρ)

/-- the decomposition equivalence adds its invariant and difference components. -/
theorem invariantDifferenceEquiv_apply (v : ρ.invariants)
    (w : Representation.Coinvariants.ker ρ) :
    invariantDifferenceEquiv ρ (v, w) = (v : V) + (w : V) := rfl

end Finite

end Math.RepresentationTheory
