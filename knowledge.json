    "id": "lean4-dependent-type-theory",
    "kernel": "Lean 4.35.0",
    "rules": [
      "dependent functions and universe-polymorphic sorts",
      "impredicative propositions and proof irrelevance",
      "definitional equality and kernel reduction",
      "strictly positive inductive families and their recursors",
      "primitive quotient types and their reduction rules"
    ],
    "reference": "https://lean-lang.org/doc/reference/4.35.0/"
  },
  "axioms": {
    "propext": {
      "description": "logically equivalent propositions are equal",
      "reference": "https://lean-lang.org/doc/reference/4.35.0/Axioms/"
    },
    "Quot.sound": {
      "description": "related elements have equal quotient representatives",
      "reference": "https://lean-lang.org/doc/reference/4.35.0/Axioms/"
    },
    "Classical.choice": {
      "description": "a nonempty type has a chosen element",
      "reference": "https://lean-lang.org/doc/reference/4.35.0/Axioms/"
    }
  },
